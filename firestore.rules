rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function photoOk(d) {
      return !('photoB64' in d) || d.photoB64 == null || d.photoB64.size() < 150000;
    }
    function notBlocked() {
      return exists(/databases/$(database)/documents/donors/$(request.auth.uid)) &&
        !get(/databases/$(database)/documents/donors/$(request.auth.uid)).data.get('blocked', false);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'user';
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /donors/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.verified == false
        && request.resource.data.get('blocked', false) == false
        && photoOk(request.resource.data);
      allow update: if (isOwner(uid)
          && request.resource.data.verified == resource.data.verified
          && request.resource.data.get('blocked', false) == resource.data.get('blocked', false)
          && photoOk(request.resource.data))
        || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /donor_private/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // One request per 5 minutes. The rate_limits doc must be written in the
    // same batch as the request, with the same server time.
    match /rate_limits/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(5, 'm');
    }

    match /requests/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && notBlocked()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'open'
        && getAfter(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.lastAt
            == request.time;
      allow update, delete: if signedIn()
        && (resource.data.requesterId == request.auth.uid || isAdmin());

      match /private/{doc} {
        allow write: if signedIn()
          && get(/databases/$(database)/documents/requests/$(id)).data.requesterId == request.auth.uid;
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/requests/$(id)).data.requesterId == request.auth.uid ||
          (exists(/databases/$(database)/documents/requests/$(id)/responses/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/requests/$(id)/responses/$(request.auth.uid)).data.status == 'accepted')
        );
      }

      match /responses/{donorId} {
        allow create, update: if isOwner(donorId) && notBlocked();
        allow read: if isOwner(donorId)
          || get(/databases/$(database)/documents/requests/$(id)).data.requesterId == request.auth.uid
          || isAdmin();
      }
    }

    // Abuse reports. One report per user per target; only admins can read them.
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['reporterId', 'type', 'targetId', 'targetUserId', 'reason', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.type in ['request', 'donor']
        && id == request.auth.uid + '_' + request.resource.data.type + '_' + request.resource.data.targetId
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 100;
      allow read, update, delete: if isAdmin();
    }

    match /donations/{id} {
      allow create: if signedIn() && request.resource.data.donorId == request.auth.uid;
      allow read: if signedIn() && (resource.data.donorId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.donorId == request.auth.uid);
    }

    match /camps/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /blogs/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /config/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}